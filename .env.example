DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_erp_pe?schema=public"

# Dominio raíz de la plataforma — cualquier hostname que no sea este ni un subdominio de este se
# trata como un dominio propio de un tenant (ver el TODO en src/middleware.ts, Fase 4 del roadmap).
ROOT_DOMAIN="tusaas.pe"
# Mismo valor, expuesto al cliente (el form de /registro arma un link con esto tras registrar).
NEXT_PUBLIC_ROOT_DOMAIN="tusaas.pe"

# JWT — generar secrets reales con `openssl rand -hex 32`, nunca reusar entre entornos. Dos pares
# completamente separados a propósito: un token de PlatformAdmin nunca debe poder pasar la
# verificación de un token de usuario de tenant, ni viceversa (ver src/lib/jwt.ts).
JWT_TENANT_ACCESS_SECRET="change-me-tenant-access-secret"
JWT_TENANT_REFRESH_SECRET="change-me-tenant-refresh-secret"
JWT_PLATFORM_ACCESS_SECRET="change-me-platform-access-secret"
JWT_PLATFORM_REFRESH_SECRET="change-me-platform-refresh-secret"

# BullMQ (hold de stock de 15 min) — mismo contenedor Redis reusado de Flashkings en dev.
REDIS_URL="redis://localhost:6379"
STOCK_HOLD_MINUTES=15

# AES-256-GCM para cifrar el certificado digital .pfx y la clave SOL de cada tenant en reposo
# (src/lib/crypto.ts) — generar con `openssl rand -hex 32`. En producción real esto debería vivir
# en un KMS/secret manager con rotación, no en una env var plana (ver el comentario en crypto.ts).
CERT_ENCRYPTION_KEY="change-me-64-hex-chars-generated-with-openssl-rand-hex-32"
SUNAT_RETRY_MAX_ATTEMPTS=5
